{
  "name": "agentsmaster",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "cloud": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/cloud/index.ts",
    "build": "vite build",
    "client": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@zxing/browser": "^0.2.1",
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tweetnacl": "^1.0.3",
    "typebox": "^1.3.27",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
