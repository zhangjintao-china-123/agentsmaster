# 电脑连接中转的地址。不写则默认 https://agents.pptxgen.com。http 会换成 ws，https 会换成 wss。
# CLOUD_URL=https://agents.pptxgen.com

# 手机配对二维码里打开的地址。不写则默认 https://agents.pptxgen.com。
# CLOUD_PUBLIC_URL=https://agents.pptxgen.com

# 看截图和 Pi 代理用的模型密钥。填好后留在本机，不要提交。
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# VISION_MODEL=qwen3-vl-plus
# LLM_API_KEY=
